<Window x:Class="PhasmoAssist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhasmoAssist"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False">

    <Grid VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
        <Grid Margin="30"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  VerticalAlignment="Center"
                  Height="100">
                <TextBlock x:Name="tbAssistTimer"
                           Grid.Column="0"
                           Grid.RowSpan="3"
                           Grid.Row="0"
                           FontSize="35"
                           FontWeight="Bold"
                           Foreground="White"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="tbEvidences"
                           Grid.Row="0"
                           FontSize="25"
                           TextWrapping="Wrap"
                           Foreground="White"/>

                <WrapPanel x:Name="wpGhosts"
                           Grid.Row="1"/>
                
                <TextBlock x:Name="tbGhostsHidden"
                           Grid.Row="2"
                           FontSize="25"
                           TextWrapping="Wrap"
                           TextDecorations="Strikethrough"
                           Foreground="LightGray"/>
            </Grid>
        </Grid>

        <Border x:Name="About"
                Margin="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="30"
                BorderBrush="White"
                Background="#AA000000"
                BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Vertical"
                            Margin="15"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                    <Border Height="5"/>
                    <TextBlock FontSize="22"
                               Foreground="White"
                               HorizontalAlignment="Center">
                        <Run Text="Phasmophobia Assist by"/>
                        <Hyperlink Click="Hyperlink_Click"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   NavigateUri="https://steamcommunity.com/profiles/76561199034666380/">
                            Bad Wolf
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="15"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Text="v. 1.6.0.3 - 2026"/>
                    <Border Height="15"/>
                    <TextBlock x:Name="tbBlink1"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Text="Please, support my friends:"/>
                    <TextBlock x:Name="tbBlink2"
                               Visibility="Collapsed"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Text="Будь ласка, підтримайте моїх друзів:"/>
                    <Border Height="10"/>

                    <UniformGrid Columns="2">
                        <Grid HorizontalAlignment="Center"
                              Margin="0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.RowSpan="2"
                                   Source="/Images/Lissanna.png"
                                   Width="64"
                                   Height="64" />

                            <TextBlock Grid.Column="2"
                                       Grid.Row="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <Hyperlink Click="Hyperlink_Click"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           NavigateUri="https://steamcommunity.com/id/funbimbomtime/">
                                    Lissanna
                                </Hyperlink>
                            </TextBlock>

                            <StackPanel Grid.Column="2"
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Image Source="/Images/Steam.png"
                                       Width="32"
                                       Height="32"
                                       Cursor="Hand"
                                       Tag="https://steamcommunity.com/id/funbimbomtime/"
                                       MouseDown="Image_MouseDown"/>
                                <Border Width="10"/>
                                <Image Source="/Images/Twitch.png"
                                       Width="32"
                                       Height="32"
                                       Cursor="Hand"
                                       Tag="https://www.twitch.tv/lissanna_add"
                                       MouseDown="Image_MouseDown"/>
                            </StackPanel>
                        </Grid>

                        <Grid HorizontalAlignment="Center"
                              Margin="0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.RowSpan="2"
                                   Source="/Images/Kystick.png"
                                   Width="64"
                                   Height="64" />

                            <TextBlock Grid.Column="2"
                                       Grid.Row="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <Hyperlink Click="Hyperlink_Click"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           NavigateUri="https://steamcommunity.com/profiles/76561199097621805/">
                                    Kystick
                                </Hyperlink>
                            </TextBlock>

                            <StackPanel Grid.Column="2"
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Image Source="/Images/Steam.png"
                                       Width="32"
                                       Height="32"
                                       Cursor="Hand"
                                       Tag="https://steamcommunity.com/profiles/76561199097621805/"
                                       MouseDown="Image_MouseDown"/>
                                <Border Width="10"/>
                                <Image Source="/Images/Twitch.png"
                                       Width="32"
                                       Height="32"
                                       Cursor="Hand"
                                       Tag="https://www.twitch.tv/kystick0"
                                       MouseDown="Image_MouseDown"/>
                            </StackPanel>
                        </Grid>

                        <Grid HorizontalAlignment="Center"
                              Margin="0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.RowSpan="2"
                                   Source="/Images/ZlotuH.png"
                                   Width="64"
                                   Height="64" />

                            <TextBlock Grid.Column="2"
                                       Grid.Row="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <Hyperlink Click="Hyperlink_Click"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           NavigateUri="https://steamcommunity.com/profiles/76561198144346215">
                                    ZlotuH
                                </Hyperlink>
                            </TextBlock>

                            <StackPanel Grid.Column="2"
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Image Source="/Images/Steam.png"
                                       Width="32"
                                       Height="32"
                                       Cursor="Hand"
                                       Tag="https://steamcommunity.com/profiles/76561198144346215"
                                       MouseDown="Image_MouseDown"/>
                                <Border Width="10"/>
                                <Image Source="/Images/Twitch.png"
                                       Width="32"
                                       Height="32"
                                       Cursor="Hand"
                                       Tag="https://www.twitch.tv/zlotuh"
                                       MouseDown="Image_MouseDown"/>
                            </StackPanel>
                        </Grid>

                        <Grid HorizontalAlignment="Center"
                              Margin="0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.RowSpan="2"
                                   Source="/Images/LuckyMan.png"
                                   Width="64"
                                   Height="64" />

                            <TextBlock Grid.Column="2"
                                       Grid.Row="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <Hyperlink Click="Hyperlink_Click"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           NavigateUri="https://steamcommunity.com/profiles/76561199426961885/">
                                    Lucky Man
                                </Hyperlink>
                            </TextBlock>

                            <StackPanel Grid.Column="2"
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Image Source="/Images/Steam.png"
                                       Width="32"
                                       Height="32"
                                       Cursor="Hand"
                                       Tag="https://steamcommunity.com/profiles/76561199426961885/"
                                       MouseDown="Image_MouseDown"/>
                                <Border Width="10"/>
                                <Image Source="/Images/Discord.png"
                                       Width="32"
                                       Height="32"
                                       Cursor="Hand"
                                       Tag="https://discord.gg/eBgN5YP3"
                                       MouseDown="Image_MouseDown"/>
                            </StackPanel>
                        </Grid>
                    </UniformGrid>

                    <Border Height="10"/>
                    <TextBlock x:Name="tbBlink3"
                               FontSize="18"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Text="Press F5 to close this window"/>
                    <TextBlock x:Name="tbBlink4"
                               Visibility="Collapsed"
                               FontSize="18"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Text="Натисніть F5, щоб закрити це вікно"/>
                    <Border Height="5"/>
                </StackPanel>

                <Image Source="/Images/Discord.png"
                       Width="32"
                       Height="32"
                       Cursor="Hand"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right"
                       Margin="0 55 20 0"
                       Tag="https://discord.gg/JY2MNDbp"
                       MouseDown="Image_MouseDown"/>
            </Grid>
        </Border>

        <Border x:Name="Randomizer"
                Margin="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                CornerRadius="30"
                BorderBrush="White"
                Background="#AA000000"
                MinWidth="450"
                MinHeight="400"
                Visibility="Collapsed"
                BorderThickness="1">
            <Grid Margin="15 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          HorizontalAlignment="Stretch">
                    <GroupBox.Header>
                        <TextBlock Text=" Мапи "
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   x:Name="tbMaps"
                                   Padding="0"/>
                    </GroupBox.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Padding="10 2"
                                FontSize="16"
                                Content="Усі"
                                x:Name="btnAllMaps"
                                Tag="0,1,2"
                                Click="MapSizeButton_Click"/>

                        <Button Grid.Row="0" Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Padding="10 2"
                                FontSize="16"
                                Content="Малі"
                                x:Name="btnSmallMaps"
                                Tag="0"
                                Click="MapSizeButton_Click"/>

                        <Button Grid.Row="1" Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Padding="10 2"
                                FontSize="16"
                                Content="Середні"
                                x:Name="btnMediumMaps"
                                Tag="1"
                                Click="MapSizeButton_Click"/>

                        <Button Grid.Row="2" Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Padding="10 2"
                                FontSize="16"
                                Content="Великі"
                                x:Name="btnLargeMaps"
                                Tag="2"
                                Click="MapSizeButton_Click"/>

                        <ListBox Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                 x:Name="MapsList"
                                 SelectionMode="Multiple">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <TextBlock Text="{TemplateBinding Content}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextDecorations" Value="{x:Null}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="FontSize" Value="18" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
                                                                             Value="False">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBoxItem Tag="0" Content="10 Ridgeview Court"/>
                            <ListBoxItem Tag="0" Content="13 Willow Street"/>
                            <ListBoxItem Tag="0" Content="42 Edgefield Road"/>
                            <ListBoxItem Tag="0" Content="6 Tanglewood Drive"/>
                            <ListBoxItem Tag="0" Content="Camp Woodwind"/>
                            <ListBoxItem Tag="0" Content="Grafton Farmhouse"/>

                            <ListBoxItem Tag="1" Content="Bleasdale Farmhouse"/>
                            <ListBoxItem Tag="1" Content="Maple Lodge Campsite"/>
                            <ListBoxItem Tag="1" Content="Point Hope"/>
                            <ListBoxItem Tag="1" Content="Prison"/>

                            <ListBoxItem Tag="2" Content="Brownstone High School"/>
                            <ListBoxItem Tag="2" Content="Sunny Meadows Mental Institution"/>
                            <ListBoxItem Tag="2" Content="Sunny Meadows Restricted"/>
                        </ListBox>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1"
                          Padding="3"
                          HorizontalAlignment="Stretch">
                    <GroupBox.Header>
                        <TextBlock Text=" Інструменти "
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   x:Name="tbInstruments"
                                   Padding="0"/>
                    </GroupBox.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Проектор D.O.T.S."
                                  x:Name="cb0"
                                  Content="Проектор D.O.T.S."/>

                        <CheckBox Grid.Row="1" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Детектор ЕМП"
                                  x:Name="cb1"
                                  Content="Детектор ЕМП"/>

                        <CheckBox Grid.Row="2" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Ліхтарик"
                                  x:Name="cb2"
                                  Content="Ліхтарик"/>

                        <CheckBox Grid.Row="3" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Книга примарних записів"
                                  x:Name="cb3"
                                  Content="Книга примарних записів"/>

                        <CheckBox Grid.Row="4" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Радіоприймач"
                                  x:Name="cb4"
                                  Content="Радіоприймач"/>

                        <CheckBox Grid.Row="5" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Термометр"
                                  x:Name="cb5"
                                  Content="Термометр"/>

                        <CheckBox Grid.Row="6" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Ультрафіолетове світло"
                                  x:Name="cb6"
                                  Content="Ультрафіолетове світло"/>

                        <CheckBox Grid.Row="7" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Відеокамера"
                                  x:Name="cb7"
                                  Content="Відеокамера"/>

                        <CheckBox Grid.Row="8" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Вогняне світло"
                                  x:Name="cb8"
                                  Content="Вогняне світло"/>

                        <CheckBox Grid.Row="9" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Спорядження на голову"
                                  x:Name="cb9"
                                  Content="Спорядження на голову"/>

                        <CheckBox Grid.Row="10" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Датчик руху"
                                  x:Name="cb10"
                                  Content="Датчик руху"/>

                        <CheckBox Grid.Row="11" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Параболічний мікрофон"
                                  x:Name="cb11"
                                  Content="Параболічний мікрофон"/>

                        <CheckBox Grid.Row="12" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Фотокамера"
                                  x:Name="cb12"
                                  Content="Фотокамера"/>

                        <CheckBox Grid.Row="13" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Сіль"
                                  x:Name="cb13"
                                  Content="Сіль"/>

                        <CheckBox Grid.Row="14" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Звуковий реєстратор"
                                  x:Name="cb14"
                                  Content="Звуковий реєстратор"/>

                        <CheckBox Grid.Row="15" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Датчик звуку"
                                  x:Name="cb15"
                                  Content="Датчик звуку"/>

                        <CheckBox Grid.Row="16" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Штатив"
                                  x:Name="cb16"
                                  Content="Штатив"/>

                        <CheckBox Grid.Row="17" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Запалювач"
                                  x:Name="cb17"
                                  Content="Запалювач"/>

                        <CheckBox Grid.Row="18" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Пахощі"
                                  x:Name="cb18"
                                  Content="Пахощі"/>

                        <CheckBox Grid.Row="19" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Заспокійливе"
                                  x:Name="cb19"
                                  Content="Заспокійливе"/>

                        <CheckBox Grid.Row="20" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Padding="10 -4 10 0"
                                  FontSize="18"
                                  Foreground="White"
                                  Background="White"
                                  Tag="Розп’яття"
                                  x:Name="cb20"
                                  Content="Розп’яття"/>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="White"
                                   Tag="0"
                                   x:Name="tb0"
                                   Text="1"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="White"
                                   Tag="1"
                                   x:Name="tb1"
                                   Text="1"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="White"
                                   Tag="2"
                                   x:Name="tb2"
                                   Text="1"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="White"
                                   Tag="3"
                                   x:Name="tb3"
                                   Text="1"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="White"
                                   Tag="4"
                                   x:Name="tb4"
                                   Text="1"/>

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="White"
                                   Tag="5"
                                   x:Name="tb5"
                                   Text="1"/>

